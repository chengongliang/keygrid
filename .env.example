# Environment for docker compose / local dev
# Copy to .env and adjust. MASTER_KEY is REQUIRED.

# 32+ char random string, encrypts provider credentials at rest — REQUIRED, 必须改成
# 随机值（openssl rand -hex 32）；保留本示例值会被应用拒绝启动
MASTER_KEY=please-change-me-to-a-long-random-secret

# JWT signing secret for web sessions — REQUIRED, 必须改成随机值（openssl rand -hex 32）；
# 保留本示例值会被应用拒绝启动
JWT_SECRET=dev-insecure-secret-change-me

# Public base URL (OAuth pkce redirect_uri) — set to your deployed origin
# 生产 HTTPS 部署时改为 https://your-domain（Caddy/公司网关终止 TLS）
PUBLIC_BASE_URL=http://127.0.0.1:8090

# Postgres 密码（app 与 postgres 共用；生产务必改强密码）
POSTGRES_PASSWORD=keygrid

# app 对宿主机暴露的端口（默认 8090）
APP_HOST_PORT=8090

# Caddy HTTPS 反代域名（仅 docker-compose.prod.yml 的 --profile tls 用，须公网可解析）
# DOMAIN=gw.company.com

# 构建期容器网络（选填）。若 docker build 时 npm/go 拉包报 DNS/EAI_AGAIN 等
# 网络不可达错误（常见于 rootless docker / 部分 WSL2 环境），取消注释改走宿主网络：
# DOCKER_BUILD_NETWORK=host

# CORS allowed origins (comma-separated; empty = deny all cross-origin, recommended).
# Only needed when the API is called from a different origin; same-origin UI needs none.
# CORS_ALLOWED_ORIGINS=https://gw.company.com

# Behind a reverse proxy (Caddy/nginx/company gateway) set 1 so login rate limiting and
# API-key IP allowlists use the real client IP (X-Forwarded-For). Keep 0 when the port is
# directly exposed — otherwise clients can spoof their IP header and bypass both.
# TRUST_PROXY=0

# provider base_url 内网地址放行（自托管可选）。=1 全部放行（多租户/不可信用户
# 可添加供应商时勿开）；细粒度改用 SSRF_ALLOWED_HOSTS / SSRF_ALLOWED_CIDRS
# SSRF_ALLOW_INTERNAL=0

# SSRF 内网上游白名单（SSRF_ALLOW_INTERNAL=0 时生效，生产可安全开启）。
# 示例：接入内网部署的 new-api → SSRF_ALLOWED_HOSTS=new-api.corp.lan 或按后缀 SSRF_ALLOWED_HOSTS=.corp.lan
# base_url 直填内网 IP 时改用：SSRF_ALLOWED_CIDRS=10.0.0.0/8,192.168.1.0/24
# SSRF_ALLOWED_HOSTS=
# SSRF_ALLOWED_CIDRS=

# e2e 专用：跳过登录限速（生产勿设 1）
# E2E_MODE=0

# Relay 限流（每 api_key；0 = 不限，Redis 不可用时自动不限流）
# RATE_LIMIT_RPM=0
# RATE_LIMIT_CONCURRENCY=0

# OAuth endpoint overrides (e2e tests / self-host forks; empty = official endpoints)
# IFLOW_CLIENT_ID= / IFLOW_CLIENT_SECRET=   # 覆盖内置的 iFlow 公开客户端凭据（一般无需配置）
# KIMI_DEVICE_CODE_URL=http://host.docker.internal:9901/api/oauth/device_authorization
# KIMI_TOKEN_URL=http://host.docker.internal:9901/api/oauth/token
# KIMI_AUTHORIZE_DEVICE_URL=http://host.docker.internal:9901/approve
# XAI_DISCOVERY_URL=https://auth.x.ai/.well-known/openid-configuration

# 首个 admin 提升：启动时该邮箱的已注册用户自动置为 admin
ADMIN_EMAIL=

# Background refresh scan interval (seconds) & refresh lead (seconds)
OAUTH_SCAN_INTERVAL=60
OAUTH_REFRESH_LEAD=300


# OIDC SSO — Keycloak / Okta / Authentik 等标准 OIDC IdP
# 推荐在 管理后台 → 系统设置 → OIDC 单点登录 中配置（保存即热生效，无需重启）；
# 以下环境变量仅在平台设置未配置对应项时兜底（存量部署平滑升级用）。
# issuer 例如 https://sso.company.com/realms/company（发现走 {issuer}/.well-known/openid-configuration）
# IdP client 需把 redirect URI 配成 {PUBLIC_BASE_URL}/api/auth/oidc/callback
OIDC_ENABLED=0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile

# 计费 P2: key 级额度硬限额开关（默认开）。关闭后额度只统计不拦截（纯成本统计模式）。
# QUOTA_ENFORCE=0
